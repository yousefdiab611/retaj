# ──────────────────────────────────────────────────────────
# Retaj Store — root .gitignore
# ──────────────────────────────────────────────────────────

# OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Editors
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.turbo/
.parcel-cache/
.svelte-kit/
coverage/
.nyc_output/
*.tsbuildinfo
dist-electron/
dist-electron-*/
release/

# Env & secrets — NEVER commit
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json
service-account.json
firebase-adminsdk*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tests / coverage
coverage/
.nyc_output/
junit.xml
playwright-report/
test-results/

# Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/backups/
backend/tmp-*.txt
backend/build-*.txt
backend/*.err.log
backend/*.log
backend/prisma-help.txt

# Generated artifacts
*.tsbuildinfo
backend/dist/
frontend/dist/
mobile_cashier/build/
mobile_cashier/.dart_tool/
mobile_cashier/.flutter-plugins
mobile_cashier/.flutter-plugins-dependencies
mobile_cashier/ios/Pods/
mobile_cashier/ios/.symlinks/
mobile_cashier/android/.gradle/
mobile_cashier/android/local.properties

# Cursor / AI
.cursor/

# Misc
*.tgz
*.zip
*.tar.gz
