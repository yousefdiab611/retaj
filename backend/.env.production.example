# RETAJ POS - Production Environment Configuration
# Copy this file to .env.production and fill in the real secrets.

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL="postgresql://retaj_app:PASSWORD@localhost:5432/retaj_db?schema=public"
SHADOW_DATABASE_URL="postgresql://retaj_app:PASSWORD@localhost:5432/retaj_db_shadow?schema=public"

# ============================================================================
# APPLICATION
# ============================================================================
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET="GENERATE_WITH_OPENSSL_AND_SET_HERE"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_DAYS="30"
REFRESH_TOKEN_SECRET="GENERATE_WITH_OPENSSL_AND_SET_HERE"

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ============================================================================
# STORE CONFIGURATION
# ============================================================================
STORE_NAME="متجر رتاج"
STORE_CURRENCY="SAR"
STORE_TAX_LABEL="ضريبة القيمة المضافة (15%)"
STORE_THANK_YOU="شكراً لك على تعاملك معنا"
STORE_PHONE="+966505555555"
STORE_ADDRESS="الرياض، المملكة العربية السعودية"

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_PRETTY=0
LOG_FILE_PATH="logs/retaj-api.log"

# ============================================================================
# SECURITY - RATE LIMITING & AUTH
# ============================================================================
AUTH_LOGIN_MAX_ATTEMPTS=20
AUTH_BLOCK_DURATION_MINUTES=30
AUTH_REFRESH_MAX=60
API_RATE_MAX=800
API_WRITE_MAX=400
LICENSE_GRACE_DAYS=7

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7

# ============================================================================
# REDIS CACHE (Optional)
# ============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Stripe Payment Gateway (Optional)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email Service (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@yourdomain.com"

# ============================================================================
# FEATURES
# ============================================================================
FEATURE_OFFLINE_MODE=true
FEATURE_LOYALTY_POINTS=true
FEATURE_QR_CODES=true
FEATURE_THERMAL_RECEIPTS=true
FEATURE_PDF_INVOICES=true
FEATURE_CUSTOMER_CREDIT=true
