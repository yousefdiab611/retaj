# ──────────────────────────────────────────────────────────
# Retaj Store Backend — environment template
# Copy to .env.development or .env.production and fill in real secrets.
# NEVER commit a real .env file.
# ──────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Set TRUST_PROXY=1 when running behind a reverse proxy (nginx, ALB, Cloudflare).
TRUST_PROXY=0

# ── Database (PostgreSQL required in production) ─────────
DATABASE_URL="postgresql://retaj_user:CHANGE_ME@localhost:5432/retaj_store?schema=public"
SHADOW_DATABASE_URL="postgresql://retaj_user:CHANGE_ME@localhost:5432/retaj_store_shadow?schema=public"

# ── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Min 16 chars in development, min 32 chars in production.
JWT_SECRET="CHANGE_ME_DEV_ONLY_USE_OPENSSL_RAND_BASE64_48"
JWT_ACCESS_EXPIRES="12h"
JWT_REFRESH_DAYS="14"

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list. Wildcards are forbidden in production.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── Logging & observability ──────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=1
LOG_FILE_PATH=./logs/retaj-api.log

# Sentry DSN (optional). Errors will be reported when set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# ── Rate limiting ────────────────────────────────────────
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REFRESH_MAX=60
API_RATE_MAX=800
API_WRITE_MAX=400

# Optional Redis-backed rate limiter (recommended for multi-instance deploys).
REDIS_URL=

# ── Branding (used in receipts) ──────────────────────────
STORE_NAME="Retaj"
STORE_CURRENCY="SAR"
STORE_TAX_LABEL="VAT (15%)"
STORE_THANK_YOU="شكراً لتسوقك معنا"

# ── Stripe (optional billing) ────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── License ──────────────────────────────────────────────
LICENSE_GRACE_DAYS=7

# ── Database recovery ────────────────────────────────────
DB_DOCKER_RECOVERY=0
DB_RECOVERY_INTERVAL_MS=10000
