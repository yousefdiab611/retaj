{
  "name": "retaj-store-frontend",
  "private": true,
  "version": "1.2.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:strict": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build:icons": "node scripts/build-icons.cjs",
    "electron:stage-backend": "node scripts/stage-desktop-backend.cjs",
    "electron-pack": "npm run build && npm run build:icons && npm run electron:stage-backend && electron-builder",
    "electron-pack:current": "npm run build && npm run build:icons && npm run electron:stage-backend && electron-builder",
    "electron-pack:win": "npm run build && npm run build:icons && npm run electron:stage-backend && electron-builder --win nsis portable --x64 --publish never",
    "electron-pack:mac": "npm run build && npm run build:icons && npm run electron:stage-backend && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "electron-pack:linux": "npm run build && npm run build:icons && npm run electron:stage-backend && electron-builder --linux AppImage deb --x64 --publish never",
    "electron-pack:all": "npm run build && npm run build:icons && npm run electron:stage-backend && electron-builder -mwl"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/react": "^8.50.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.487.0",
    "node-machine-id": "^1.1.12",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "react-window": "^2.2.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.cjs",
  "homepage": "./",
  "build": {
    "appId": "com.retaj.pos",
    "productName": "Retaj Store",
    "copyright": "Copyright © 2026 Retaj Store",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/retaj-icon.ico",
      "public/retaj-icon.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/{electron,electron-builder,@vitejs/**,@vitest/**,@testing-library/**,vite,vitest,jsdom,sharp,png-to-ico,typescript,tailwindcss,autoprefixer,postcss,concurrently,wait-on}/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/**/{*.md,*.markdown,LICENSE*,license*,README*,readme*,CHANGELOG*,changelog*,HISTORY*,history*,*.test.js,*.spec.js,test/**/*,tests/**/*,__tests__/**/*,docs/**/*,doc/**/*,examples/**/*,example/**/*}",
      "!node_modules/**/{.eslintrc*,.prettierrc*,.editorconfig,.babelrc*,.npmignore,.gitignore,.travis.yml,.github/**/*,*.ts,!*.d.ts,tsconfig*.json,rollup.config*,webpack.config*,gulpfile*}"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../dist-electron-staging/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/retaj-icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "public/retaj-icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "Retaj-Store-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "public/retaj-icon.png",
      "maintainer": "Retaj Store <support@retaj.local>",
      "artifactName": "Retaj-Store-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Retaj Store",
      "artifactName": "Retaj-Store-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "Retaj Store ${version}",
      "icon": "public/retaj-icon.png"
    },
    "portable": {
      "artifactName": "Retaj-POS-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yousefdiab611",
        "repo": "retaj",
        "channel": "latest",
        "publishAutoUpdate": true
      }
    ]
  }
}
