{
  "name": "retaj-store-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-pack": "npm run build && electron-builder",
    "electron-pack:current": "npm run build && electron-builder",
    "electron-pack:win": "npm run build && electron-builder --win nsis portable --x64 --ia32",
    "electron-pack:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "electron-pack:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "electron-pack:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@sentry/react": "^8.50.0",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.487.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "react-window": "^2.2.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "electron-store": "^9.0.0",
    "electron-updater": "^6.8.3",
    "node-machine-id": "^1.1.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.cjs",
  "homepage": "./",
  "build": {
    "appId": "com.retaj.pos",
    "productName": "Retaj Store",
    "copyright": "Copyright © 2026 Retaj Store",
    "directories": {
      "output": "../../dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/retaj-icon.ico"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/retaj-icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.business",
      "icon": "public/retaj-icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "Retaj-Store-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Office",
      "icon": "public/retaj-icon.png",
      "maintainer": "Retaj Store <support@retaj.local>",
      "artifactName": "Retaj-Store-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Retaj Store",
      "artifactName": "Retaj-Store-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "Retaj Store ${version}",
      "icon": "public/retaj-icon.png"
    },
    "portable": {
      "artifactName": "Retaj-POS-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${UPDATE_SERVER_URL}",
        "channel": "latest"
      }
    ]
  }
}
