# ──────────────────────────────────────────────────────────
# Retaj Store Frontend — environment template
# Copy to .env.development or .env.production
# ──────────────────────────────────────────────────────────

# Leave empty in development to use the Vite dev proxy (/api → http://localhost:3001)
# In production set the absolute URL of the API.
VITE_API_URL=

# Sentry DSN (optional). When set, browser errors are reported to Sentry.
VITE_SENTRY_DSN=

# Build/release tag (auto-injected by CI). Used for Sentry release tagging.
VITE_APP_RELEASE=

# Optional Stripe publishable key for client-side checkout
VITE_STRIPE_PUBLISHABLE_KEY=
